    {
      "name": "01 - Users",
      "description": "Creates a unique active user and exercises user reads and updates.",
      "item": [
        {
          "name": "Create user",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const runId = `${Date.now()}-${Math.floor(Math.random() * 1000000)}`;",
                  "pm.collectionVariables.set('testEmail', `postman.${runId}@example.com`);",
                  "pm.collectionVariables.set('idempotencyKey', `postman-transfer-${runId}`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('User created', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.expect(body.status).to.eql('ACTIVE');",
                  "pm.collectionVariables.set('userId', body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Ada\",\n  \"lastName\": \"Lovelace\",\n  \"email\": \"{{testEmail}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/users",
            "description": "Generates a unique email and stores the returned UUID as userId."
          },
          "response": []
        },
        {
          "name": "Get user",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('User returned', () => pm.response.to.have.status(200));",
                  "pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('userId'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/users/{{userId}}"
          },
          "response": []
        },
        {
          "name": "Update user",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('User updated', () => pm.response.to.have.status(200));",
                  "pm.expect(pm.response.json().lastName).to.eql('Byron');"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Ada\",\n  \"lastName\": \"Byron\",\n  \"email\": \"{{testEmail}}\",\n  \"status\": \"ACTIVE\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/users/{{userId}}"
          },
          "response": []
        },
        {
          "name": "List users",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('User page returned', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.expect(body.content).to.be.an('array');",
                  "pm.expect(body).to.have.property('totalElements');"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/users?page=0&size=10&sort=createdAt,desc"
          },
          "response": []
        }
      ]
