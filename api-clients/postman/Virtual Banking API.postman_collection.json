    {
      "name": "04 - Transfers",
      "description": "Runs the happy path, exact idempotent replay, and representative business failures.",
      "item": [
        {
          "name": "Transfer 25 USD",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Transfer created', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.expect(body.status).to.eql('COMPLETED');",
                  "pm.collectionVariables.set('transferId', body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sourceAccountId\": \"{{sourceAccountId}}\",\n  \"destinationAccountId\": \"{{destinationAccountId}}\",\n  \"amount\": 25.00,\n  \"description\": \"Postman transfer\",\n  \"idempotencyKey\": \"{{idempotencyKey}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/transfers"
          },
          "response": []
        },
        {
          "name": "Replay transfer idempotently",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Original transfer returned', () => pm.response.to.have.status(200));",
                  "pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('transferId'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sourceAccountId\": \"{{sourceAccountId}}\",\n  \"destinationAccountId\": \"{{destinationAccountId}}\",\n  \"amount\": 25.00,\n  \"description\": \"Postman transfer\",\n  \"idempotencyKey\": \"{{idempotencyKey}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/transfers"
          },
          "response": []
        },
        {
          "name": "Get transfer",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Transfer returned', () => pm.response.to.have.status(200));",
                  "pm.expect(pm.response.json().status).to.eql('COMPLETED');"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/transfers/{{transferId}}"
          },
          "response": []
        },
        {
          "name": "Cross-currency USD to EUR",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const enabled = pm.environment.get('crossCurrencyEnabled') === 'true';",
                  "pm.test(enabled ? 'Cross-currency transfer completed' : 'Unconfigured provider is rejected safely', () => pm.response.to.have.status(enabled ? 201 : 503));",
                  "const body = pm.response.json();",
                  "if (enabled) {",
                  "  pm.expect(body.status).to.eql('COMPLETED');",
                  "  pm.expect(body.sourceCurrency).to.eql('USD');",
                  "  pm.expect(body.destinationCurrency).to.eql('EUR');",
                  "  pm.expect(body.destinationAmount).to.be.above(0);",
                  "  pm.expect(body.exchangeRateProvider).to.eql('DECOLECTA_SBS_AVERAGE');",
                  "} else {",
                  "  pm.expect(body.code).to.eql('EXCHANGE_RATE_NOT_CONFIGURED');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sourceAccountId\": \"{{sourceAccountId}}\",\n  \"destinationAccountId\": \"{{conversionAccountId}}\",\n  \"amount\": 1.00,\n  \"description\": \"USD to EUR conversion\",\n  \"idempotencyKey\": \"{{idempotencyKey}}-currency\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/transfers",
            "description": "Set integrations.decolecta.api-key in the server application.properties and crossCurrencyEnabled=true in the Postman environment to test a live conversion."
          },
          "response": []
        },
        {
          "name": "Reject same account",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Same-account transfer rejected', () => pm.response.to.have.status(422));",
                  "pm.expect(pm.response.json().code).to.eql('SAME_ACCOUNT_TRANSFER');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
