meta {
  name: Create destination USD account
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/users/{{userId}}/accounts
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "accountType": "SAVINGS",
    "currency": "USD"
  }
}

tests {
  test("destination account is created and captured", function () {
    expect(res.getStatus()).to.equal(201);
    bru.setVar("destinationAccountId", res.getBody().id);
  });
}
