meta {
  name: Logout
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/auth/logout
  body: json
  auth: inherit
}

headers { Content-Type: application/json }
body:json {
  { "refreshToken": "{{refreshToken}}" }
}

tests {
  test("session revoked", function () {
    expect(res.getStatus()).to.equal(204);
  });
}
