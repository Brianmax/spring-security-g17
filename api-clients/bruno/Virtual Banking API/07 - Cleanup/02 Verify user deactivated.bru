meta {
  name: Verify user was deactivated
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/users/{{userId}}
  body: none
  auth: none
}

tests {
  test("user remains available as inactive", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().status).to.equal("INACTIVE");
  });
}
