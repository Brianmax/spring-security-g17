meta {
  name: List users
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/v1/users?page=0&size=10&sort=createdAt,desc
  body: none
  auth: none
}

tests {
  test("paginated users are returned", function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body.content).to.be.an("array");
    expect(body).to.have.property("totalElements");
  });
}
