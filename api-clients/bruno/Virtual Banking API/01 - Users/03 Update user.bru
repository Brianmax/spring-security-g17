meta {
  name: Update user
  type: http
  seq: 3
}

put {
  url: {{baseUrl}}/api/v1/users/{{userId}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "firstName": "Ada",
    "lastName": "Byron",
    "email": "{{testEmail}}",
    "status": "ACTIVE"
  }
}

tests {
  test("user is updated", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().lastName).to.equal("Byron");
  });
}
