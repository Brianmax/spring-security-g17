meta {
  name: Get deposit transaction
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/transactions/{{transactionId}}
  body: none
  auth: none
}

tests {
  test("deposit transaction is returned", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().transactionType).to.equal("DEPOSIT");
  });
}
